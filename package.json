{
  "name": "seed-express",
  "version": "0.0.0",
  "private": true,
  "description": "Express Basic starter: a notes form persisted to SQLite.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node --watch ./bin/www",
    "migrate": "node ./scripts/migrate.js",
    "dev-secret": "node ./scripts/create-dev-secret.js",
    "test": "node --test"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "http-errors": "2.0.1",
    "morgan": "1.12.1"
  }
}
